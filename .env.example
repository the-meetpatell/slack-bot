# Slack Credentials
SLACK_SIGNING_SECRET=your_slack_signing_secret
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# Zoho CRM Credentials (Self Client)
ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token

# Vercel Serverless Function Helper (Keep as 0 for raw body signature check)
NODEJS_HELPERS=0

# Optional: Zoho Data Center Override (Only set if log in is at .in, .eu, .sa)
# ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
# ZOHO_API_URL=https://www.zohoapis.in

# Optional Defaults & Assignment Rules
LEAD_SOURCE=Ops Team
LEAD_STATUS=New (Incoming)
ZOHO_ASSIGNMENT_RULE_ID=

# Optional: Slack channels
# SLACK_CHANNEL_ID=C0C4ZCBT32M              # where referral summaries post (#internal-client-referrals)
# SLACK_ALLOWED_CHANNELS=C0C4ZCBT32M,C0BRC5SQF1P  # where /refer may be run
